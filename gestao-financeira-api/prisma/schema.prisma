generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUM — espelha CATEGORIAS_DISPONIVEIS do frontend
// ─────────────────────────────────────────────
enum Categoria {
  ALIMENTACAO
  TRANSPORTE
  LAZER
  SAUDE
  EDUCACAO
  OUTROS
}

// ─────────────────────────────────────────────
// USER — perfil + credenciais de acesso
// Corresponde a @perfil_wisecash + @senha_wisecash + @biometria_wisecash
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  ocupacao  String?
  foto      String?  // URL da imagem armazenada (substituirá o URI local)
  senha     String?  // Armazenar sempre com hash (bcrypt) — nunca plain text
  biometria Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transacoes Transacao[]
  metas      Meta[]
  orcamentos Orcamento[]

  @@map("users")
}

// ─────────────────────────────────────────────
// TRANSACAO — transações simples e parceladas
// Corresponde a @transacoes_wisecash
//
// Lógica de parcelamento:
//   - Compra parcelada: várias Transacao com o mesmo grupoId
//   - grupoId null = transação individual
// ─────────────────────────────────────────────
model Transacao {
  id                 String    @id @default(uuid())

  // Campos de parcelamento (null quando não parcelado)
  grupoId            String?   // UUID partilhado entre todas as parcelas do mesmo grupo
  descricaoBase      String?   // "Viagem ao Japão" — título do grupo de parcelas
  valorTotalDaCompra Decimal?  @db.Decimal(12, 2) // Valor total da compra parcelada

  // Campos presentes em todas as transações
  descricao          String    // "Viagem ao Japão (1/3)" ou "Supermercado"
  valor              Decimal   @db.Decimal(12, 2)
  data               DateTime  @db.Timestamptz
  categoria          Categoria @default(OUTROS)
  tags               String?   // "#ViagemSP, #Presente"
  anexo              String?   // URL do recibo/comprovativo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índices para as queries mais frequentes do frontend
  @@index([userId])
  @@index([grupoId])          // Agrupar parcelas rapidamente
  @@index([userId, data])     // Filtrar por mês no Dashboard e Orçamentos
  @@index([userId, categoria]) // Calcular gastos por categoria
  @@map("transacoes")
}

// ─────────────────────────────────────────────
// META — simulação de poupança com juros compostos
// Corresponde a @metas_wisecash
// ─────────────────────────────────────────────
model Meta {
  id             String  @id @default(uuid())
  nome           String
  valorAlvo      Decimal @db.Decimal(12, 2)
  depositoMensal Decimal @db.Decimal(12, 2)
  taxaJuros      Decimal @db.Decimal(6, 4) // Ex: 0.0080 = 0.8% ao mês (não guardado no frontend — adicionado para completude)
  previsaoData   String  // "jan. 2027" — string formatada mantida para compatibilidade imediata com frontend
  meses          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("metas")
}

// ─────────────────────────────────────────────
// ORCAMENTO — limite de gastos por categoria/mês
// Corresponde a @orcamentos_wisecash
//
// Frontend guarda: { 'Lazer': 500, 'Alimentação': 1000 }
// Backend normaliza num registo por (userId, categoria)
// ─────────────────────────────────────────────
model Orcamento {
  id        String    @id @default(uuid())
  categoria Categoria
  limite    Decimal   @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("orcamentos")
}

{
  "expo": {
    "name": "",
    "slug": "Wisecash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#075900"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#075900"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
